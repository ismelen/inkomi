    {
      "id": "SikXKG5rhfjRZxIHDzap0",
      "type": "text",
      "x": 13665.402864318467,
      "y": -3618.9978418288874,
      "width": 582.979248046875,
      "height": 1296,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bHh",
      "roundness": null,
      "seed": 296838313,
      "version": 80,
      "versionNonce": 927141097,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791297652532,
      "link": null,
      "locked": false,
      "text": "interface Request {\n  sources: Source[];\n  configs: Map<string, MangaConfig>;\n}\n\ninterface NoItemsSource {\n  title: string;\n  type: \"file\" | \"folder\" | \"md5\";\n  size?: number;\n  filename?: string;\n}\n\ninterface Source extends NoItemsSource {\n  configPointer?: number;\n  leftToRight: boolean; // reading direction\n  join: boolean;\n  items: NoItemsSource[];\n}\n\ninterface MangaConfig {\n  rotateDoublePage: boolean;\n  targetWidth: number;\n  targetHeight: number;\n  cropTolerance: number; // [0.0, 1.0] || -1\n  enlarge: boolean; // upscale small images to target dims\n  embed: boolean; // fill blanks to fit target dims\n  gamma: number; // [0.1, 3.0] or [1.8, 2.6]; def: 1.0\n  brightness: number; // [-1.0, 1.0]\n  contrast: number; // [0.0, 2.0]\n  grayscale: boolean; // Forzar escala de grises\n  blackPointThreshold: number; // [0.0, 1.0], def=0.06\n  whitePointThreshold: number; // [0.0, 1.0], def=0.95\n  dithering: boolean; // Difusión de puntos de tinta\n  palette8bit: boolean; // convert to 8-bit palette instead of 24-bit\n  quality: number; // %\n  sharpen: SharpenOptions;\n}\n\ninterface SharpenOptions {\n  enabled: boolean;\n  radius: number; // [1, 5]; def=1\n  x1: number; // [1.0, 3.0]; def=1.5\n  y2: number; // [0.0, 50.0]; def=20\n  y3: number; // [0.0, 50.0]; def=50\n  m1: number; // [0.0, +inf]; def=0\n  m2: number; // [1.0, 5.0]; def=3\n}\n",
      "fontSize": 20,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "interface Request {\n  sources: Source[];\n  configs: Map<string, MangaConfig>;\n}\n\ninterface NoItemsSource {\n  title: string;\n  type: \"file\" | \"folder\" | \"md5\";\n  size?: number;\n  filename?: string;\n}\n\ninterface Source extends NoItemsSource {\n  configPointer?: number;\n  leftToRight: boolean; // reading direction\n  join: boolean;\n  items: NoItemsSource[];\n}\n\ninterface MangaConfig {\n  rotateDoublePage: boolean;\n  targetWidth: number;\n  targetHeight: number;\n  cropTolerance: number; // [0.0, 1.0] || -1\n  enlarge: boolean; // upscale small images to target dims\n  embed: boolean; // fill blanks to fit target dims\n  gamma: number; // [0.1, 3.0] or [1.8, 2.6]; def: 1.0\n  brightness: number; // [-1.0, 1.0]\n  contrast: number; // [0.0, 2.0]\n  grayscale: boolean; // Forzar escala de grises\n  blackPointThreshold: number; // [0.0, 1.0], def=0.06\n  whitePointThreshold: number; // [0.0, 1.0], def=0.95\n  dithering: boolean; // Difusión de puntos de tinta\n  palette8bit: boolean; // convert to 8-bit palette instead of 24-bit\n  quality: number; // %\n  sharpen: SharpenOptions;\n}\n\ninterface SharpenOptions {\n  enabled: boolean;\n  radius: number; // [1, 5]; def=1\n  x1: number; // [1.0, 3.0]; def=1.5\n  y2: number; // [0.0, 50.0]; def=20\n  y3: number; // [0.0, 50.0]; def=50\n  m1: number; // [0.0, +inf]; def=0\n  m2: number; // [1.0, 5.0]; def=3\n}\n",
      "autoResize": true,
      "lineHeight": 1.35
    }
  ],
