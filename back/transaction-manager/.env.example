# transaction-manager: copy to ~/inkomi/back/transaction-manager/.env on the k3s server (Secret
# transaction-manager-env). Values marked [k8s] are set by deploy/k8s/inkomi.yaml. Listens on 3000.

# Same public key as auth-service, one line with \n inside double quotes
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Cloudflare R2: presigned upload urls for <source id>/<filename>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

NATS_URL=nats://localhost:4222                 # [k8s] nats://nats:4222
DB_PATH=transactions.db                         # [k8s] /data/transactions.db on its volume
SCHEMA_PATH=./migrations/transactions.sql       # [k8s] /app/migrations/transactions.sql
