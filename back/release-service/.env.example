# release-service: copy to ~/inkomi/back/release-service/.env on the k3s server (Secret
# release-service-env). Every variable has a default, so the file may be empty. Values marked
# [k8s] are set by deploy/k8s/app/release-service.yaml.

PORT=3200                       # [k8s]

# Repository (owner/name) whose GitHub Releases carry the apk; built by
# .github/workflows/build-mobile.yml, tag v<expo.version> with the asset inkomi.apk
GITHUB_REPO=ismelen/inkomi
GITHUB_API_URL=https://api.github.com
# Optional: without a token the GitHub API allows 60 requests per hour per IP (the cache below
# keeps it far from that)
GITHUB_TOKEN=
APK_ASSET_NAME=inkomi.apk

# How long the latest release is kept before asking GitHub again
RELEASE_CACHE_TTL=5m
