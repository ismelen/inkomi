# library-service: copy to ~/inkomi/back/library-service/.env on the k3s server (Secret
# library-service-env). Values marked [k8s] are set by deploy/k8s/app/library-service.yaml.

PORT=3001                       # [k8s]
# Same public key as auth-service, one line with \n inside double quotes
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Cloudflare R2 (S3 API): downloaded books are stored as <id>/<filename>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

NATS_URL=nats://localhost:4222  # [k8s] nats://nats:4222
NATS_ACK_WAIT=30m
NATS_MAX_DELIVER=3

# Libgen mirrors: list of mirrors (empty = built-in default) and how often they're re-checked
SLUM_URL=
MIRROR_REFRESH_INTERVAL=1h
MIRROR_REFRESH_COOLDOWN=1m
