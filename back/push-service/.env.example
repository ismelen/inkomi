# push-service: copy to ~/inkomi/back/push-service/.env on the k3s server (Secret push-service-env)
# and put the Firebase service account next to it as ~/inkomi/back/push-service/firebase.json.
# Values marked [k8s] are set by deploy/k8s/inkomi.yaml.

# Cloudflare R2: finished files to send to Dropbox
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

NATS_URL=nats://localhost:4222   # [k8s] nats://nats:4222
NATS_ACK_WAIT=30m
NATS_MAX_DELIVER=3

# Service token to call auth-service's internal routes. Its public key goes in auth-service's
# SERVICE_PUBLIC_KEYS under "push-service". Generate the pair with:
#   openssl genrsa -out push.key 2048 && openssl rsa -in push.key -pubout -out push.pub
SERVICE_NAME=push-service
SERVICE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
SERVICE_TOKEN_TTL=1m
AUTH_SERVICE_URL=http://localhost:3101   # [k8s] http://auth-service:3101
AUTH_SERVICE_AUDIENCE=auth-service
AUTH_SERVICE_TIMEOUT=10s

FIREBASE_CREDENTIALS_FILE=firebase.json  # [k8s] /app/firebase.json
DROPBOX_CHUNK_MB=64
