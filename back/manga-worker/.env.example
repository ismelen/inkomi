# manga-worker: copy to ~/inkomi/back/manga-worker/.env on the k3s server (Secret
# manga-worker-env). Values marked [k8s] are set by deploy/k8s/inkomi.yaml.
# The pipeline also reads the R2 values of this file to upload the preview samples and to run
# the e2e tests.

# Cloudflare R2: sources are read from and epubs written to <id>/<filename>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

NATS_URL=nats://localhost:4222  # [k8s] nats://nats:4222
NATS_ACK_WAIT=30m               # longest a page conversion may take before NATS redelivers it
NATS_MAX_DELIVER=3
WORKERS=2                       # [k8s] pages processed at once (each one holds several decoded copies)
PORT=3003                       # [k8s] public preview page (/preview)

# Preview page: the samples are stored as PREVIEW_SAMPLES_ID/<file> (uploaded by the pipeline
# from back/manga-worker/samples)
PREVIEW_SAMPLES_ID=samples
PREVIEW_COLOR_SAMPLE=color.jpg
PREVIEW_BW_SAMPLE=bw.jpg
PREVIEW_MAX_SAMPLE_MB=15
PREVIEW_RATE_PER_MINUTE=6       # processed previews per client ip
PREVIEW_BURST=3
PREVIEW_MAX_CONCURRENT=2        # previews processed at once in the whole pod
PREVIEW_TIMEOUT=20s
PREVIEW_TRUST_PROXY=false       # [k8s] true: client ip from X-Forwarded-For (set by Caddy/Traefik)
