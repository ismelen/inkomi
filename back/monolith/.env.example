# monolith: copy to ~/inkomi/back/monolith/.env on the Oracle server (docker compose reads it) and
# put the Firebase service account next to it as ~/inkomi/back/monolith/firebase.json.
# It is the union of the microservices' variables without the ones for talking between services
# (NATS_URL, REDIS_URL, INTERNAL_PORT, SERVICE_*, AUTH_SERVICE_*): the queue is an embedded NATS
# and the modules call each other in-process.

PORT=3000
# SQLite databases (users.db, transactions.db, jobs.db) and the JetStream store (nats/).
# The compose file mounts ./data here.
DATA_DIR=/app/data

# --- auth ---
# RS256 key pair of the access tokens (PEM with \n escapes). Generate with:
#   openssl genrsa -out jwt.pem 2048 && openssl rsa -in jwt.pem -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Issuer of the access tokens. Keep auth-service to accept the tokens issued by the microservices.
TOKEN_ISSUER=auth-service
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Comma-separated OAuth client ids (web, android, ios) accepted for Google sign-in.
GOOGLE_CLIENT_IDS=
DROPBOX_APP_KEY=
# 32 random bytes in base64 (openssl rand -base64 32). Never change it: the stored Dropbox tokens
# would become unreadable.
TOKEN_ENCRYPTION_KEY=
EXTERNAL_TIMEOUT=10s

# --- storage ---
# local: the files live on the server's disk (DATA_DIR/files) and the clients upload and download
# them through /files with signed urls. r2: Cloudflare R2 (the R2_* variables below).
STORAGE=local
# Public address of the monolith: the signed upload and download urls point to it.
PUBLIC_URL=https://inkomi.duckdns.org
# Key of the signed urls; empty derives it from TOKEN_ENCRYPTION_KEY.
STORAGE_SIGNING_KEY=
# Stored files nobody touched for this long are deleted (downloadable results included).
FILES_RETENTION=168h
# Free disk kept out of every upload's reservation; uploads that don't fit are rejected with
# 507 ("try again later") and heavy jobs wait below it.
DISK_RESERVE_MB=1024
# Space reservation of an upload: epub size relative to its manga file, and the size assumed for
# a library download.
STORAGE_EPUB_RATIO=1.2
LIBRARY_ESTIMATE_MB=100

# --- Cloudflare R2 (only with STORAGE=r2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- job queue (embedded NATS) ---
# How long a job may run before it is redelivered, and how many times a failing job is delivered.
NATS_ACK_WAIT=30m
NATS_MAX_DELIVER=3

# --- library ---
SLUM_URL=
MIRROR_REFRESH_INTERVAL=1h
MIRROR_REFRESH_COOLDOWN=1m

# --- manga ---
# Pages processed at once across every job and the preview (default: the CPUs).
WORKERS=
# Manga jobs at once; empty picks min(CPUs, free memory / MANGA_JOB_MEMORY_MB) at startup.
MANGA_CONCURRENCY=
MANGA_JOB_MEMORY_MB=512
# No new manga, join or kepub job starts while the free memory (of the container when it has a
# limit) is below this; the waiting jobs aren't redelivered.
MEMORY_RESERVE_MB=400
# Preview samples, stored as PREVIEW_SAMPLES_ID/<file> in R2 (uploaded by the e2e image's
# upload-samples from back/microservices/manga-worker/samples).
PREVIEW_SAMPLES_ID=samples
PREVIEW_COLOR_SAMPLE=color.jpg
PREVIEW_BW_SAMPLE=bw.jpg
PREVIEW_MAX_SAMPLE_MB=15
PREVIEW_RATE_PER_MINUTE=6
PREVIEW_BURST=3
PREVIEW_MAX_CONCURRENT=2
PREVIEW_TIMEOUT=20s
# true behind Caddy, which sets X-Forwarded-For.
PREVIEW_TRUST_PROXY=true

# --- epub ---
JOIN_TTL=24h
JOIN_LOCK_TTL=30m
JOIN_MAX_BLOCK_MB=200

# --- push ---
FIREBASE_CREDENTIALS_FILE=/app/firebase.json
DROPBOX_CHUNK_MB=64

# --- release ---
GITHUB_REPO=ismelen/inkomi
GITHUB_API_URL=https://api.github.com
# Optional: without it the GitHub API allows 60 requests per hour.
GITHUB_TOKEN=
APK_ASSET_NAME=inkomi.apk
RELEASE_CACHE_TTL=5m
