# auth-service: copy to ~/inkomi/back/auth-service/.env on the k3s server (the pipeline turns it
# into the Secret auth-service-env). Values marked [k8s] are set by deploy/k8s/inkomi.yaml and
# override this file in the cluster.

PORT=3100                    # [k8s] public API (/auth, /users)
INTERNAL_PORT=3101           # [k8s] internal routes for other services, never exposed
DB_PATH=users.db             # [k8s] /data/users.db on its volume
SERVICE_NAME=auth-service    # issuer of the access tokens and audience of the service tokens

# RSA key pair of the user access tokens (RS256). Generate it with:
#   openssl genrsa -out jwt.key 2048 && openssl rsa -in jwt.key -pubout -out jwt.pub
# Keep the PEM on one line with \n inside double quotes. Every service that checks user tokens
# (library-service, transaction-manager) needs the same JWT_PUBLIC_KEY.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Google Sign-In: comma-separated OAuth client ids (android, ios, web)
GOOGLE_CLIENT_IDS=xxxx.apps.googleusercontent.com,yyyy.apps.googleusercontent.com
DROPBOX_APP_KEY=
# 32 random bytes in base64 to encrypt the stored Dropbox tokens: openssl rand -base64 32
# Changing it makes the stored tokens unreadable.
TOKEN_ENCRYPTION_KEY=

# JSON object service name → public key PEM of the services allowed on the internal routes.
# push-service signs with SERVICE_PRIVATE_KEY (see push-service/.env.example).
SERVICE_PUBLIC_KEYS='{"push-service":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"}'
EXTERNAL_TIMEOUT=10s
