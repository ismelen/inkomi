# epub-worker: copy to ~/inkomi/back/epub-worker/.env on the k3s server (Secret epub-worker-env).
# Values marked [k8s] are set by deploy/k8s/app/epub-worker.yaml.

# Cloudflare R2: epubs to join/kepubify as <id>/<filename>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

NATS_URL=nats://localhost:4222      # [k8s] nats://nats:4222
NATS_ACK_WAIT=30m
NATS_MAX_DELIVER=3
REDIS_URL=redis://localhost:6379/0  # [k8s] redis://redis:6379/0

JOIN_TTL=24h          # how long the chapters of a folder wait for the rest
JOIN_LOCK_TTL=30m     # how long a merge may hold its group
JOIN_MAX_BLOCK_MB=200 # max size of each merged epub
